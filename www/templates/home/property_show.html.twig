{% extends 'base.html.twig' %}

{% import 'partials/_form_macros.html.twig' as ui %}

{% block title %}{{ property.title }} | Havre{% endblock %}

{% block body %}
    {% set label_class = 'text-xs font-medium leading-none text-[#1c1c19]' %}
    {% set input_class = 'min-h-[50px] w-full rounded-[4px] border border-[#c0c8c4] bg-[#fcf9f4] px-[17px] py-[13px] text-base text-[#1c1c19] outline-none transition placeholder:text-[#717975] focus:border-[#2f5d50] focus:ring-[3px] focus:ring-[#2f5d50]/12' %}
    {% set error_class = 'text-xs font-medium leading-snug text-[#ba1a1a]' %}
    {% set images = property.images %}
    {% set main_image = property.mainImage %}

    <main class="mx-auto grid w-full max-w-[1180px] gap-8 px-6 py-10 md:px-10">
        <nav>
            <a class="text-sm font-semibold text-[#154539] transition hover:text-[#2f5d50]" href="{{ path('app_catalogue') }}">Retour au catalogue</a>
        </nav>

        <section class="grid gap-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5d50]">{{ property.category.label }}</p>
                    <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-[#1c1c19] md:text-5xl">{{ property.title }}</h1>
                    <p class="mt-3 text-base leading-7 text-[#404945]">{{ property.city }}, {{ property.country.label }}</p>
                </div>
                <div class="flex flex-col items-start gap-3 md:items-end">
                    <p class="text-sm text-[#404945]"><span class="text-2xl font-semibold text-[#1c1c19]">{{ property.nightlyPrice }} EUR</span> / nuit</p>
                    {% if app.user and app.user.id != property.user.id %}
                        <form method="post" action="{{ path(isFavorite ? 'app_favorite_remove' : 'app_favorite_add', { id: property.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('favorite_property_' ~ property.id) }}">
                            {% include 'components/_button.html.twig' with { tag: 'button', type: 'submit', label: isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris', variant: isFavorite ? 'danger' : 'secondary' } only %}
                        </form>
                    {% endif %}
                </div>
            </div>

            <div class="grid gap-3 lg:grid-cols-[2fr_1fr]">
                <div class="aspect-[16/10] overflow-hidden rounded-[12px] bg-[#e8eee9]">
                    {% if main_image %}
                        <img class="h-full w-full object-cover" src="{{ asset('uploads/properties/' ~ main_image.image) }}" alt="Photo principale de {{ property.title }}">
                    {% else %}
                        <div class="flex h-full w-full items-center justify-center px-4 text-center text-sm font-semibold text-[#717975]">Photo a venir</div>
                    {% endif %}
                </div>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                    {% for image in images|slice(0, 2) %}
                        <div class="aspect-[16/10] overflow-hidden rounded-[12px] bg-[#e8eee9]">
                            <img class="h-full w-full object-cover" src="{{ asset('uploads/properties/' ~ image.image) }}" alt="Photo de {{ property.title }}">
                        </div>
                    {% else %}
                        <div class="aspect-[16/10] rounded-[12px] bg-[#e8eee9]"></div>
                        <div class="aspect-[16/10] rounded-[12px] bg-[#e8eee9]"></div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
            <div class="grid gap-6">
                <section class="rounded-[12px] border border-[#154539]/10 bg-white/70 p-6">
                    <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Le logement</h2>
                    <p class="mt-4 text-base leading-7 text-[#404945]">{{ property.description }}</p>

                    <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Voyageurs</dt>
                            <dd class="mt-1 font-semibold text-[#1c1c19]">{{ property.maxGuest }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Chambres</dt>
                            <dd class="mt-1 font-semibold text-[#1c1c19]">{{ property.bedrooms }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Lits</dt>
                            <dd class="mt-1 font-semibold text-[#1c1c19]">{{ property.beds }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Bains</dt>
                            <dd class="mt-1 font-semibold text-[#1c1c19]">{{ property.bathrooms }}</dd>
                        </div>
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Surface</dt>
                            <dd class="mt-1 font-semibold text-[#1c1c19]">{{ property.areaM2 }} m2</dd>
                        </div>
                    </dl>
                </section>

                <section class="rounded-[12px] border border-[#154539]/10 bg-white/70 p-6">
                    <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Equipements</h2>
                    <div class="mt-5 grid gap-3 sm:grid-cols-2">
                        {% for propertyEquipment in property.propertyEquipments %}
                            <span class="rounded-[10px] border border-[#154539]/10 bg-[#fcf9f4] px-4 py-3 text-sm font-semibold text-[#404945]">{{ propertyEquipment.equipment.label }}</span>
                        {% else %}
                            <p class="text-sm leading-6 text-[#717975]">Aucun equipement renseigne.</p>
                        {% endfor %}
                    </div>
                    <p class="mt-5 text-sm font-semibold text-[#154539]">{{ property.petsAllowed ? 'Animaux acceptes' : 'Animaux non acceptes' }}</p>
                </section>

                <section class="rounded-[12px] border border-[#154539]/10 bg-white/70 p-6">
                    <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Hote</h2>
                    <p class="mt-4 text-base font-semibold text-[#1c1c19]">{{ property.user.firstname }} {{ property.user.lastname }}</p>
                    {% if property.user.bio %}
                        <p class="mt-2 text-sm leading-6 text-[#404945]">{{ property.user.bio }}</p>
                    {% endif %}
                </section>
            </div>

            <aside class="rounded-[12px] border border-[#154539]/10 bg-white/80 p-6 shadow-[0_20px_70px_rgba(21,69,57,0.08)] lg:sticky lg:top-6">
                <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Demande de reservation</h2>
                <p class="mt-2 text-sm leading-6 text-[#404945]">Le prix est calcule au serveur a partir des dates selectionnees.</p>

                {{ form_start(bookingForm, { attr: { class: 'mt-6 grid gap-4', novalidate: 'novalidate' } }) }}
                    {{ form_errors(bookingForm) }}
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
                        {{ ui.field(bookingForm.checkIn, label_class, input_class, error_class) }}
                        {{ ui.field(bookingForm.checkOut, label_class, input_class, error_class) }}
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        {{ ui.field(bookingForm.adultCount, label_class, input_class, error_class) }}
                        {{ ui.field(bookingForm.childrenCount, label_class, input_class, error_class) }}
                    </div>
                    <div class="rounded-[10px] bg-[#fcf9f4] p-4 text-sm leading-6 text-[#404945]">
                        <p><span class="font-semibold text-[#1c1c19]">{{ property.nightlyPrice }} EUR</span> par nuit</p>
                        <p>Frais de menage : {{ property.cleaningFee }} EUR</p>
                        <p>Caution : {{ property.deposit }} EUR</p>
                    </div>
                    <button class="inline-flex min-h-[50px] items-center justify-center rounded-[10px] bg-[#2f5d50] px-6 text-sm font-semibold text-white transition hover:bg-[#154539]" type="submit">Demander a reserver</button>
                {{ form_end(bookingForm) }}
            </aside>
        </section>
    </main>
{% endblock %}
