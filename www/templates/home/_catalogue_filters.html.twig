<form class="grid gap-4 rounded-[12px] border border-[#154539]/10 bg-white/70 p-5 shadow-[0_20px_70px_rgba(21,69,57,0.06)] md:grid-cols-[1fr_260px_auto]" method="get" action="{{ path('app_catalogue') }}">
    <label class="grid gap-2">
        <span class="text-xs font-medium leading-none text-[#1c1c19]">Ville</span>
        <input class="min-h-[50px] w-full rounded-[4px] border border-[#c0c8c4] bg-[#fcf9f4] px-[17px] py-[13px] text-base text-[#1c1c19] outline-none transition placeholder:text-[#717975] focus:border-[#2f5d50] focus:ring-[3px] focus:ring-[#2f5d50]/12" type="search" name="ville" value="{{ search.city }}" placeholder="Lyon, Nantes, Paris">
    </label>

    <label class="grid gap-2">
        <span class="text-xs font-medium leading-none text-[#1c1c19]">Categorie</span>
        <select class="min-h-[50px] w-full rounded-[4px] border border-[#c0c8c4] bg-[#fcf9f4] px-[17px] py-[13px] text-base text-[#1c1c19] outline-none transition focus:border-[#2f5d50] focus:ring-[3px] focus:ring-[#2f5d50]/12" name="categorie">
            <option value="">Toutes</option>
            {% for category in categories %}
                <option value="{{ category.id }}" {{ search.categoryId == category.id ? 'selected' : '' }}>{{ category.label }}</option>
            {% endfor %}
        </select>
    </label>

    <div class="flex items-end gap-3">
        <button class="inline-flex min-h-[50px] items-center justify-center rounded-[10px] bg-[#2f5d50] px-6 text-sm font-semibold text-white transition hover:bg-[#154539]" type="submit">Rechercher</button>
        {% if search.city or search.categoryId %}
            <a class="inline-flex min-h-[50px] items-center justify-center rounded-[10px] border border-[#c0c8c4] px-5 text-sm font-semibold text-[#154539] transition hover:border-[#154539]" href="{{ path('app_catalogue') }}">Effacer</a>
        {% endif %}
    </div>
</form>
