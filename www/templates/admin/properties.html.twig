{% extends 'base.html.twig' %}

{% block title %}Logements admin | Havre{% endblock %}

{% block body %}
    <main class="mx-auto grid w-full max-w-[1180px] gap-8 px-6 py-10 md:px-10">
        <section class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5d50]">Administration</p>
                <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-[#1c1c19] md:text-5xl">Logements</h1>
            </div>
            <div class="flex flex-wrap gap-2">
                {% for label in ['DRAFT', 'PUBLISHED', 'HIDDEN'] %}
                    <a class="inline-flex min-h-[38px] items-center rounded-[8px] border px-3 text-xs font-semibold {{ current_status == label ? 'border-[#154539] bg-[#154539] text-white' : 'border-[#c0c8c4] text-[#154539]' }}" href="{{ path('app_admin_properties', { status: label }) }}">{{ label }}</a>
                {% endfor %}
                <a class="inline-flex min-h-[38px] items-center rounded-[8px] border px-3 text-xs font-semibold {{ current_status == '' ? 'border-[#154539] bg-[#154539] text-white' : 'border-[#c0c8c4] text-[#154539]' }}" href="{{ path('app_admin_properties') }}">Tous</a>
            </div>
        </section>

        <section class="grid gap-4">
            {% for property in properties %}
                <article class="grid gap-4 border border-[#154539]/10 bg-white/75 p-5 md:grid-cols-[1fr_auto] md:items-center">
                    <div>
                        <div class="flex flex-wrap items-center gap-3">
                            <h2 class="font-serif text-2xl font-semibold text-[#1c1c19]">{{ property.title }}</h2>
                            {% include 'components/_status_badge.html.twig' with { label: property.status.label } only %}
                        </div>
                        <p class="mt-2 text-sm leading-6 text-[#404945]">{{ property.city }}, {{ property.country.label }} - {{ property.user.firstname }} {{ property.user.lastname }}</p>
                    </div>
                    {% if property.status.label != 'HIDDEN' %}
                        <form method="post" action="{{ path('app_admin_property_hide', { id: property.id }) }}" onsubmit="return confirm('Masquer ce logement ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin_hide_property_' ~ property.id) }}">
                            {% include 'components/_button.html.twig' with { tag: 'button', type: 'submit', label: 'Masquer', variant: 'danger', extra_class: 'w-full' } only %}
                        </form>
                    {% endif %}
                </article>
            {% else %}
                {% include 'components/_empty_state.html.twig' with { title: 'Aucun logement', description: 'Aucun logement ne correspond a ce filtre.' } only %}
            {% endfor %}
        </section>
    </main>
{% endblock %}
