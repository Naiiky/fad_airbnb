{% extends 'base.html.twig' %}

{% block title %}Administration | Havre{% endblock %}

{% block body %}
    <main class="mx-auto grid w-full max-w-[1180px] gap-8 px-6 py-10 md:px-10">
        <section class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5d50]">Administration</p>
                <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-[#1c1c19] md:text-5xl">Tableau de bord</h1>
            </div>
            <div class="flex flex-wrap gap-3">
                {% include 'components/_button.html.twig' with { href: path('app_admin_users'), label: 'Utilisateurs', variant: 'secondary' } only %}
                {% include 'components/_button.html.twig' with { href: path('app_admin_properties'), label: 'Logements', variant: 'secondary' } only %}
            </div>
        </section>

        <section class="grid gap-4 md:grid-cols-3">
            <div class="border border-[#154539]/10 bg-white/75 p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Utilisateurs</p>
                <p class="mt-2 text-3xl font-semibold text-[#1c1c19]">{{ users.total }}</p>
            </div>
            <div class="border border-[#154539]/10 bg-white/75 p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Logements</p>
                <p class="mt-2 text-3xl font-semibold text-[#1c1c19]">{{ properties|length }}</p>
            </div>
            <div class="border border-[#154539]/10 bg-white/75 p-5">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">A moderer</p>
                <p class="mt-2 text-3xl font-semibold text-[#1c1c19]">{{ properties|filter(property => property.status.label == 'PUBLISHED')|length }}</p>
            </div>
        </section>
    </main>
{% endblock %}
