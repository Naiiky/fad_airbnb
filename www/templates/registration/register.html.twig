{% extends 'base.html.twig' %}

{% block auth_layout %}{% endblock %}

{% block title %}Inscription | Havre{% endblock %}

{% block body %}
    {% set label_base = 'text-xs font-medium leading-none text-[#1c1c19]' %}
    {% set label_error = 'text-[#ba1a1a]' %}
    {% set input_base = 'min-h-[50px] w-full rounded-[4px] border border-[#c0c8c4] bg-[#fcf9f4] px-[17px] py-[13px] text-base text-[#1c1c19] outline-none transition placeholder:text-[#717975] focus:border-[#2f5d50] focus:ring-[3px] focus:ring-[#2f5d50]/12' %}
    {% set input_error = 'border-[#ba1a1a] bg-[#ffdad6]/10 focus:border-[#ba1a1a] focus:ring-[#ba1a1a]/12' %}
    {% set error_text = 'text-xs font-medium leading-snug text-[#ba1a1a]' %}

    <main class="flex min-h-screen bg-[#fcf9f4]">
        <section class="relative hidden min-w-0 flex-1 overflow-hidden bg-[#f0ede9] lg:block" aria-hidden="true">
            <img class="absolute inset-0 h-full w-full object-cover" src="{{ asset('images/auth/register-editorial.png') }}" alt="">
            <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-transparent"></div>
            <div class="absolute bottom-12 left-12 max-w-[448px] text-white">
                <h2 class="font-serif text-5xl font-semibold leading-[1.05]">Des espaces pensés pour la quiétude.</h2>
                <p class="mt-4 max-w-[340px] text-base leading-7 text-white/86">Accédez à notre collection privée de retraites architecturales.</p>
            </div>
        </section>

        <section class="grid min-h-screen w-full place-items-center px-5 py-8 lg:w-[52%] lg:px-10" aria-labelledby="registration-title">
            <div class="w-full max-w-[500px] rounded-[12px] border border-[#154539]/10 bg-[#fcf9f4]/96 p-6 shadow-[0_20px_70px_rgba(21,69,57,0.12)] sm:p-8 lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none">
                <a class="font-serif text-2xl font-semibold leading-[1.3] text-[#154539]" href="{{ path('app_home') }}">Havre</a>

                <header class="mt-8">
                    <h1 id="registration-title" class="font-serif text-[42px] font-semibold leading-[1.05] text-[#1c1c19] sm:text-[56px]">Rejoignez-nous</h1>
                    <p class="mt-4 max-w-[420px] text-base leading-7 text-[#404945]">Créez votre compte pour réserver des séjours d'exception et gérer vos voyages.</p>
                </header>

                {{ form_start(registrationForm, { attr: { class: 'mt-8 grid gap-5', novalidate: 'novalidate' } }) }}
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="grid gap-2">
                            {{ form_label(registrationForm.firstname, null, { label_attr: { class: label_base ~ (registrationForm.firstname.vars.errors|length ? ' ' ~ label_error : '') } }) }}
                            {{ form_widget(registrationForm.firstname, { attr: { class: input_base ~ (registrationForm.firstname.vars.errors|length ? ' ' ~ input_error : '') } }) }}
                            {% for error in registrationForm.firstname.vars.errors %}
                                <p class="{{ error_text }}">{{ error.message }}</p>
                            {% endfor %}
                        </div>

                        <div class="grid gap-2">
                            {{ form_label(registrationForm.lastname, null, { label_attr: { class: label_base ~ (registrationForm.lastname.vars.errors|length ? ' ' ~ label_error : '') } }) }}
                            {{ form_widget(registrationForm.lastname, { attr: { class: input_base ~ (registrationForm.lastname.vars.errors|length ? ' ' ~ input_error : '') } }) }}
                            {% for error in registrationForm.lastname.vars.errors %}
                                <p class="{{ error_text }}">{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="grid gap-2">
                        {{ form_label(registrationForm.birthDate, null, { label_attr: { class: label_base ~ (registrationForm.birthDate.vars.errors|length ? ' ' ~ label_error : '') } }) }}
                        {{ form_widget(registrationForm.birthDate, { attr: { class: input_base ~ (registrationForm.birthDate.vars.errors|length ? ' ' ~ input_error : '') } }) }}
                        <p class="text-xs leading-5 text-[#717975]">18 ans révolus requis pour s'inscrire.</p>
                        {% for error in registrationForm.birthDate.vars.errors %}
                            <p class="{{ error_text }}">{{ error.message }}</p>
                        {% endfor %}
                    </div>

                    <div class="grid gap-2">
                        {{ form_label(registrationForm.email, null, { label_attr: { class: label_base ~ (registrationForm.email.vars.errors|length ? ' ' ~ label_error : '') } }) }}
                        {{ form_widget(registrationForm.email, { attr: { class: input_base ~ (registrationForm.email.vars.errors|length ? ' ' ~ input_error : '') } }) }}
                        {% for error in registrationForm.email.vars.errors %}
                            <p class="{{ error_text }}">{{ error.message }}</p>
                        {% endfor %}
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="grid gap-2">
                            {{ form_label(registrationForm.plainPassword.first, null, { label_attr: { class: label_base ~ (registrationForm.plainPassword.first.vars.errors|length ? ' ' ~ label_error : '') } }) }}
                            {{ form_widget(registrationForm.plainPassword.first, { attr: { class: input_base ~ (registrationForm.plainPassword.first.vars.errors|length ? ' ' ~ input_error : '') } }) }}
                            {% for error in registrationForm.plainPassword.first.vars.errors %}
                                <p class="{{ error_text }}">{{ error.message }}</p>
                            {% endfor %}
                        </div>

                        <div class="grid gap-2">
                            {{ form_label(registrationForm.plainPassword.second, null, { label_attr: { class: label_base ~ (registrationForm.plainPassword.second.vars.errors|length ? ' ' ~ label_error : '') } }) }}
                            {{ form_widget(registrationForm.plainPassword.second, { attr: { class: input_base ~ (registrationForm.plainPassword.second.vars.errors|length ? ' ' ~ input_error : '') } }) }}
                            {% for error in registrationForm.plainPassword.second.vars.errors %}
                                <p class="{{ error_text }}">{{ error.message }}</p>
                            {% endfor %}
                        </div>
                    </div>

                    {% for error in registrationForm.plainPassword.vars.errors %}
                        <p class="{{ error_text }}">{{ error.message }}</p>
                    {% endfor %}

                    <div class="grid gap-3 pt-1">
                        <label class="flex items-start gap-3 text-sm leading-6 text-[#404945]">
                            {{ form_widget(registrationForm.termsAccepted, { attr: { class: 'mt-1 size-4 shrink-0 rounded border-[#c0c8c4] accent-[#2f5d50]' } }) }}
                            <span>J'accepte les <a class="font-medium text-[#154539] underline-offset-4 hover:underline" href="#">Conditions Générales d'Utilisation</a>.</span>
                        </label>
                        {% for error in registrationForm.termsAccepted.vars.errors %}
                            <p class="{{ error_text }}">{{ error.message }}</p>
                        {% endfor %}

                        <label class="flex items-start gap-3 text-sm leading-6 text-[#404945]">
                            {{ form_widget(registrationForm.privacyAccepted, { attr: { class: 'mt-1 size-4 shrink-0 rounded border-[#c0c8c4] accent-[#2f5d50]' } }) }}
                            <span>J'ai lu et j'accepte la <a class="font-medium text-[#154539] underline-offset-4 hover:underline" href="#">Politique de Confidentialité</a> concernant le traitement de mes données.</span>
                        </label>
                        {% for error in registrationForm.privacyAccepted.vars.errors %}
                            <p class="{{ error_text }}">{{ error.message }}</p>
                        {% endfor %}
                    </div>

                    <button class="mt-1 inline-flex min-h-[54px] w-full items-center justify-center rounded-[10px] bg-[#2f5d50] px-6 text-base font-semibold text-white transition hover:bg-[#154539] focus:outline-none focus:ring-[3px] focus:ring-[#2f5d50]/18" type="submit">Créer mon compte</button>

                    {{ form_rest(registrationForm) }}
                {{ form_end(registrationForm, { render_rest: false }) }}

                <p class="mt-6 text-center text-sm text-[#404945]">Déjà inscrit ? <a class="font-semibold text-[#154539] underline-offset-4 hover:underline" href="{{ path('app_login') }}">Se connecter</a></p>
            </div>
        </section>
    </main>
{% endblock %}
