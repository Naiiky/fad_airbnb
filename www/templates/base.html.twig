<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Havre{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Ctext y='1.2em' font-size='96'%3EH%3C/text%3E%3C/svg%3E">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-[#fcf9f4] font-sans text-[#1c1c19] antialiased">
        {% if block('auth_layout') is not defined %}
            <header class="flex min-h-[72px] items-center justify-between border-b border-[#154539]/12 bg-[#fcf9f4]/95 px-6 md:px-[72px]">
                <a class="font-serif text-2xl font-semibold leading-[1.3] text-[#154539]" href="{{ path('app_home') }}">Havre</a>
                <nav class="flex items-center gap-6 text-sm font-medium text-[#404945]" aria-label="Navigation principale">
                    {% if app.user %}
                        <span class="hidden max-w-[220px] truncate sm:inline">{{ app.user.userIdentifier }}</span>
                        <a class="transition hover:text-[#154539]" href="{{ path('app_account_show') }}">Compte</a>
                        <a class="transition hover:text-[#154539]" href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a class="transition hover:text-[#154539]" href="{{ path('app_login') }}">Connexion</a>
                        <a class="rounded-[10px] bg-[#2f5d50] px-[18px] py-2.5 text-white transition hover:bg-[#154539]" href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </nav>
            </header>
        {% endif %}

        {% for label, messages in app.flashes %}
            <div class="mx-auto mt-4 max-w-4xl rounded-[10px] border px-4 py-3 text-sm {{ label == 'success' ? 'border-[#2f5d50]/25 text-[#154539]' : 'border-[#c0c8c4] text-[#404945]' }}" role="status">
                {% for message in messages %}
                    <p>{{ message }}</p>
                {% endfor %}
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </body>
</html>
