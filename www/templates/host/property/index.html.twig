{% extends 'base.html.twig' %}

{% block title %}Mes logements | Havre{% endblock %}

{% block body %}
    <main class="mx-auto grid w-full max-w-[1180px] gap-8 px-6 py-10 md:px-10">
        {% include 'host/property/_page_header.html.twig' with {
            title: 'Mes logements',
            description: 'Pilotez vos annonces, leur statut et leur mise en ligne depuis votre espace proprietaire.',
            action_href: path('app_host_property_new'),
            action_label: 'Ajouter un logement',
            action_class: 'inline-flex min-h-[46px] items-center justify-center rounded-[10px] bg-[#2f5d50] px-5 text-sm font-semibold text-white transition hover:bg-[#154539]'
        } only %}

        <section class="grid gap-4 md:grid-cols-3">
            <a class="border border-[#154539]/10 bg-white/75 p-5 transition hover:border-[#154539]/30 focus:outline-none focus:ring-[3px] focus:ring-[#2f5d50]/20" href="{{ path('app_host_booking_index', { status: 'PENDING' }) }}">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Demandes en attente</p>
                <p class="mt-2 text-3xl font-semibold text-[#1c1c19]">{{ pendingBookings }}</p>
            </a>
            <a class="border border-[#154539]/10 bg-white/75 p-5 transition hover:border-[#154539]/30 focus:outline-none focus:ring-[3px] focus:ring-[#2f5d50]/20" href="{{ path('app_host_booking_index') }}">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Reservations</p>
                <p class="mt-2 text-lg font-semibold text-[#1c1c19]">Toutes les demandes</p>
            </a>
            <a class="border border-[#154539]/10 bg-white/75 p-5 transition hover:border-[#154539]/30 focus:outline-none focus:ring-[3px] focus:ring-[#2f5d50]/20" href="{{ path('app_account_show') }}">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[#717975]">Compte</p>
                <p class="mt-2 text-lg font-semibold text-[#1c1c19]">Profil hote</p>
            </a>
        </section>

        {% if properties|length > 0 %}
            <section class="grid gap-5">
                {% for property in properties %}
                    {% include 'host/property/_property_card.html.twig' with { property: property } only %}
                {% endfor %}
            </section>
        {% else %}
            {% include 'host/property/_empty_state.html.twig' only %}
        {% endif %}
    </main>
{% endblock %}
