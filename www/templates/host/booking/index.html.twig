{% extends 'base.html.twig' %}

{% block title %}Demandes recues | Havre{% endblock %}

{% block body %}
    <main class="mx-auto grid w-full max-w-[1180px] gap-8 px-6 py-10 md:px-10">
        <section class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#2f5d50]">Hote</p>
                <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-[#1c1c19] md:text-5xl">Demandes recues</h1>
                <p class="mt-3 max-w-[680px] text-sm leading-6 text-[#404945]">Suivez les reservations de vos logements et traitez les demandes en attente.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                {% for label in ['PENDING', 'ACCEPTED', 'REJECTED', 'CANCELLED'] %}
                    <a class="inline-flex min-h-[38px] items-center rounded-[8px] border px-3 text-xs font-semibold {{ current_status == label ? 'border-[#154539] bg-[#154539] text-white' : 'border-[#c0c8c4] text-[#154539]' }}" href="{{ path('app_host_booking_index', { status: label }) }}">{{ label }}</a>
                {% endfor %}
                <a class="inline-flex min-h-[38px] items-center rounded-[8px] border px-3 text-xs font-semibold {{ current_status == '' ? 'border-[#154539] bg-[#154539] text-white' : 'border-[#c0c8c4] text-[#154539]' }}" href="{{ path('app_host_booking_index') }}">Toutes</a>
            </div>
        </section>

        {% if bookings|length %}
            <section class="grid gap-4">
                {% for booking in bookings %}
                    {% include 'partials/_booking_card.html.twig' with { booking: booking, mode: 'host' } only %}
                {% endfor %}
            </section>
        {% else %}
            {% include 'components/_empty_state.html.twig' with {
                title: 'Aucune demande',
                description: 'Les nouvelles demandes de reservation apparaitront ici.',
                action_href: path('app_host_property_index'),
                action_label: 'Voir mes logements'
            } only %}
        {% endif %}
    </main>
{% endblock %}
