{% set property = booking.property %}
{% set image = property.mainImage %}

<article class="grid gap-5 border border-[#154539]/10 bg-white/75 p-5 shadow-[0_20px_70px_rgba(21,69,57,0.06)] md:grid-cols-[160px_1fr_auto] md:items-center">
    <div class="aspect-[4/3] overflow-hidden rounded-[8px] bg-[#e8eee9]">
        {% if image %}
            <img class="h-full w-full object-cover" src="{{ asset('uploads/properties/' ~ image.image) }}" alt="Photo de {{ property.title }}">
        {% else %}
            <div class="flex h-full items-center justify-center px-3 text-center text-sm font-semibold text-[#717975]">Photo a venir</div>
        {% endif %}
    </div>

    <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
            <h2 class="font-serif text-2xl font-semibold leading-tight text-[#1c1c19]">{{ property.title }}</h2>
            {% include 'components/_status_badge.html.twig' with { label: booking.status.label } only %}
        </div>
        <p class="mt-2 text-sm leading-6 text-[#404945]">{{ property.city }}, {{ property.country.label }}</p>
        <dl class="mt-4 grid gap-3 text-sm text-[#404945] sm:grid-cols-4">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[#717975]">Arrivee</dt>
                <dd class="mt-1 font-semibold text-[#1c1c19]">{{ booking.checkIn|date('d/m/Y') }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[#717975]">Depart</dt>
                <dd class="mt-1 font-semibold text-[#1c1c19]">{{ booking.checkOut|date('d/m/Y') }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[#717975]">Voyageurs</dt>
                <dd class="mt-1 font-semibold text-[#1c1c19]">{{ booking.guestCount }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-[#717975]">Total</dt>
                <dd class="mt-1 font-semibold text-[#1c1c19]">{{ booking.totalAmount }} EUR</dd>
            </div>
        </dl>
        {% if mode == 'host' %}
            <p class="mt-3 text-sm text-[#404945]">Voyageur : {{ booking.user.firstname }} {{ booking.user.lastname }}</p>
        {% else %}
            <p class="mt-3 text-sm text-[#404945]">Hote : {{ property.user.firstname }} {{ property.user.lastname }}</p>
        {% endif %}
    </div>

    <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
        {% if mode == 'host' and booking.status.label == 'PENDING' %}
            <form method="post" action="{{ path('app_host_booking_accept', { id: booking.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('accept_booking_' ~ booking.id) }}">
                {% include 'components/_button.html.twig' with { tag: 'button', type: 'submit', label: 'Accepter', variant: 'primary', extra_class: 'w-full' } only %}
            </form>
            <form method="post" action="{{ path('app_host_booking_reject', { id: booking.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('reject_booking_' ~ booking.id) }}">
                {% include 'components/_button.html.twig' with { tag: 'button', type: 'submit', label: 'Refuser', variant: 'secondary', extra_class: 'w-full' } only %}
            </form>
        {% endif %}

        {% if booking.status.label in ['PENDING', 'ACCEPTED'] and booking.checkIn > date('today') %}
            <form method="post" action="{{ path(mode == 'host' ? 'app_host_booking_cancel' : 'app_traveler_booking_cancel', { id: booking.id }) }}" onsubmit="return confirm('Annuler cette reservation ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_booking_' ~ booking.id) }}">
                {% include 'components/_button.html.twig' with { tag: 'button', type: 'submit', label: 'Annuler', variant: 'danger', extra_class: 'w-full' } only %}
            </form>
        {% endif %}
    </div>
</article>
