<header class="flex min-h-[72px] flex-col items-start justify-center gap-3 border-b border-[#154539]/12 bg-[#fcf9f4]/95 px-6 py-4 md:flex-row md:items-center md:justify-between md:px-[72px]">
    <a class="font-serif text-2xl font-semibold leading-[1.3] text-[#154539]" href="{{ path('app_home') }}">Havre</a>
    <nav class="flex w-full flex-wrap items-center gap-3 text-sm font-medium text-[#404945] md:w-auto md:gap-6" aria-label="Navigation principale">
        <a class="transition hover:text-[#154539]" href="{{ path('app_catalogue') }}">Catalogue</a>
        {% if app.user %}
            <span class="hidden max-w-[220px] truncate sm:inline">{{ app.user.userIdentifier }}</span>
            <a class="transition hover:text-[#154539]" href="{{ path('app_traveler_booking_index') }}">Mes voyages</a>
            <a class="transition hover:text-[#154539]" href="{{ path('app_host_property_index') }}">Mes logements</a>
            <a class="transition hover:text-[#154539]" href="{{ path('app_host_booking_index') }}">Demandes</a>
            <a class="transition hover:text-[#154539]" href="{{ path('app_favorite_index') }}">Favoris</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a class="transition hover:text-[#154539]" href="{{ path('app_admin_dashboard') }}">Admin</a>
            {% endif %}
            <a class="transition hover:text-[#154539]" href="{{ path('app_account_show') }}">Compte</a>
            <a class="transition hover:text-[#154539]" href="{{ path('app_logout') }}">Deconnexion</a>
        {% else %}
            <a class="transition hover:text-[#154539]" href="{{ path('app_login') }}">Connexion</a>
            <a class="rounded-[10px] bg-[#2f5d50] px-[18px] py-2.5 text-white transition hover:bg-[#154539]" href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
    </nav>
</header>
