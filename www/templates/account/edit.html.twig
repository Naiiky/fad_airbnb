{% extends 'base.html.twig' %}

{% import 'partials/_form_macros.html.twig' as ui %}

{% block title %}Modifier mon profil | Havre{% endblock %}

{% block body %}
    {% set label_class = 'text-xs font-medium leading-none text-[#1c1c19]' %}
    {% set input_class = 'min-h-[50px] w-full rounded-[4px] border border-[#c0c8c4] bg-[#fcf9f4] px-[17px] py-[13px] text-base text-[#1c1c19] outline-none transition placeholder:text-[#717975] focus:border-[#2f5d50] focus:ring-[3px] focus:ring-[#2f5d50]/12' %}
    {% set file_class = 'block w-full rounded-[4px] border border-[#c0c8c4] bg-[#fcf9f4] text-sm text-[#404945] file:mr-4 file:min-h-[50px] file:border-0 file:bg-[#2f5d50] file:px-5 file:text-sm file:font-semibold file:text-white hover:file:bg-[#154539] focus:outline-none focus:ring-[3px] focus:ring-[#2f5d50]/12' %}
    {% set textarea_class = input_class ~ ' min-h-[140px] resize-y' %}
    {% set error_class = 'text-xs font-medium leading-snug text-[#ba1a1a]' %}
    {% set checkbox_class = 'flex items-center gap-3 rounded-[10px] border border-[#154539]/10 bg-[#fcf9f4] px-4 py-3 text-sm font-medium text-[#404945]' %}

    <main class="mx-auto grid w-full max-w-[1040px] gap-8 px-6 py-10 md:px-10">
        <header class="flex flex-col justify-between gap-5 border-b border-[#154539]/12 pb-8 lg:flex-row lg:items-end">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#717975]">Compte Havre</p>
                <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-[#1c1c19] md:text-6xl">Modifier mon profil</h1>
                <p class="mt-4 max-w-[620px] text-base leading-7 text-[#404945]">Mettez à jour les informations visibles dans votre espace personnel.</p>
            </div>
            <a class="inline-flex min-h-[46px] items-center justify-center rounded-[10px] border border-[#c0c8c4] px-5 text-sm font-semibold text-[#154539] transition hover:border-[#154539]" href="{{ path('app_account_show') }}">Retour au compte</a>
        </header>

        {{ form_start(profileForm, { attr: { class: 'grid gap-6', novalidate: 'novalidate' } }) }}
            <section class="rounded-[12px] border border-[#154539]/10 bg-white/60 p-6 shadow-[0_20px_70px_rgba(21,69,57,0.08)]">
                <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Identité</h2>
                <div class="mt-6 grid gap-5 md:grid-cols-2">
                    {{ ui.field(profileForm.firstname, label_class, input_class, error_class) }}
                    {{ ui.field(profileForm.lastname, label_class, input_class, error_class) }}
                    {{ ui.field(profileForm.phone, label_class, input_class, error_class) }}
                    <div class="grid gap-2">
                        {{ form_label(profileForm.avatarFile, null, { label_attr: { class: label_class ~ (profileForm.avatarFile.vars.errors|length ? ' text-[#ba1a1a]' : '') } }) }}
                        {{ form_widget(profileForm.avatarFile.file, { attr: { class: file_class ~ (profileForm.avatarFile.vars.errors|length ? ' border-[#ba1a1a] bg-[#ffdad6]/10 focus:ring-[#ba1a1a]/12' : '') } }) }}
                        <p class="text-xs leading-5 text-[#717975]">JPEG, PNG ou WebP, 3 Mo maximum. La photo sera convertie et stockée en WebP.</p>
                        {% for error in profileForm.avatarFile.vars.errors %}
                            <p class="{{ error_class }}">{{ error.message }}</p>
                        {% endfor %}
                        {% for error in profileForm.avatarFile.file.vars.errors %}
                            <p class="{{ error_class }}">{{ error.message }}</p>
                        {% endfor %}
                    </div>
                </div>
            </section>

            <section class="rounded-[12px] border border-[#154539]/10 bg-white/60 p-6">
                <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Adresse</h2>
                <div class="mt-6 grid gap-5 md:grid-cols-2">
                    <div class="md:col-span-2">
                        {{ ui.field(profileForm.address, label_class, input_class, error_class) }}
                    </div>
                    {{ ui.field(profileForm.city, label_class, input_class, error_class) }}
                    {{ ui.field(profileForm.zipCode, label_class, input_class, error_class) }}
                    <div class="grid gap-2 md:col-span-2">
                        {{ form_label(profileForm.country, null, { label_attr: { class: label_class ~ (profileForm.country.vars.errors|length ? ' text-[#ba1a1a]' : '') } }) }}
                        {{ form_widget(profileForm.country, { attr: { class: input_class ~ (profileForm.country.vars.errors|length ? ' border-[#ba1a1a] bg-[#ffdad6]/10 focus:border-[#ba1a1a] focus:ring-[#ba1a1a]/12' : '') } }) }}
                        {% for error in profileForm.country.vars.errors %}
                            <p class="{{ error_class }}">{{ error.message }}</p>
                        {% endfor %}
                    </div>
                </div>
            </section>

            <section class="grid gap-6 lg:grid-cols-[1fr_360px]">
                <div class="rounded-[12px] border border-[#154539]/10 bg-white/60 p-6">
                    <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Bio</h2>
                    <div class="mt-6">
                        {{ ui.field(profileForm.bio, label_class, textarea_class, error_class) }}
                    </div>
                </div>

                <div class="rounded-[12px] border border-[#154539]/10 bg-white/60 p-6">
                    <h2 class="font-serif text-3xl font-semibold text-[#1c1c19]">Langues</h2>
                    <div class="mt-6 grid gap-3">
                        {% for language in profileForm.languages %}
                            {{ ui.checkbox_card(language, checkbox_class) }}
                        {% else %}
                            <p class="text-sm leading-6 text-[#717975]">Aucune langue disponible.</p>
                        {% endfor %}
                    </div>
                    {% for error in profileForm.languages.vars.errors %}
                        <p class="mt-3 {{ error_class }}">{{ error.message }}</p>
                    {% endfor %}
                </div>
            </section>

            <div class="flex flex-col-reverse gap-3 border-t border-[#154539]/12 pt-6 sm:flex-row sm:justify-end">
                <a class="inline-flex min-h-[50px] items-center justify-center rounded-[10px] border border-[#c0c8c4] px-6 text-sm font-semibold text-[#154539] transition hover:border-[#154539]" href="{{ path('app_account_show') }}">Annuler</a>
                <button class="inline-flex min-h-[50px] items-center justify-center rounded-[10px] bg-[#2f5d50] px-6 text-sm font-semibold text-white transition hover:bg-[#154539] focus:outline-none focus:ring-[3px] focus:ring-[#2f5d50]/18" type="submit">Enregistrer le profil</button>
            </div>

            {{ form_rest(profileForm) }}
        {{ form_end(profileForm, { render_rest: false }) }}
    </main>
{% endblock %}
